# ============================================================
# 正式環境環境變數範本（複製成 .env 後填入實際值，勿 commit .env）
# 與 .env.example 的差別：此檔列出正式環境「必須改」的項目與安全預設
# ============================================================

# [必改] 應用程式密鑰。每個環境獨立、不可重用開發值。
# 產生指令：python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-產生後填入-切勿沿用開發值

# [必改] CORS 來源白名單，逗號分隔。正式環境填實際前端網域，不可留 localhost。
# 例：ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
ALLOWED_ORIGINS=https://CHANGE-ME.example.com

# [建議保留] 登入速率限制（slowapi 格式 N/[second|minute|hour]），per IP。
# 正式環境務必維持 RATE_LIMIT_ENABLED=true。
LOGIN_RATE_LIMIT=5/minute
RATE_LIMIT_ENABLED=true

# [視部署而定] 資料庫連線。預設 SQLite（單機足夠，見部署 checklist 的 Postgres 評估）。
# 改 Postgres 時：postgresql+psycopg://user:pass@host:5432/carbon_saas
DATABASE_URL=sqlite:///./carbon_saas.db

# [前端] client-side API 位址。正式環境填使用者瀏覽器可達的 backend 公開網址。
# 例：NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://CHANGE-ME-api.example.com
