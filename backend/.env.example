# 產生指令：python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-generate-with-secrets-token_hex-32

DATABASE_URL=sqlite:///./carbon_saas.db

# CORS 來源白名單，逗號分隔；正式環境改成實際前端網域
ALLOWED_ORIGINS=http://localhost:3000

# Login rate limit（slowapi 格式 N/[second|minute|hour]）。預設 5/minute per IP。
LOGIN_RATE_LIMIT=5/minute
# 設 false 完全關閉（測試環境用，正式不建議）
RATE_LIMIT_ENABLED=true
